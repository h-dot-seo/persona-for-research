{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:persona-for-research:editor-profile:human-validation-record:v1",
  "title": "Detached human validation record (editor documentation; placeholders allowed)",
  "description": "Authoritative consumer: human_validation.check. Generated empty text, empty collections and null status remain editable. Judgments are never fabricated. Documentation only, not import readiness, binding validation, permission or approval. No fields are added to instance JSON.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "human-validation-record.v1",
      "readOnly": true
    },
    "author_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])",
      "readOnly": true
    },
    "version": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])",
      "readOnly": true
    },
    "build_id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])",
      "readOnly": true
    },
    "persona_payload_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "readOnly": true,
      "description": "Copy the generated binding unchanged; schema matching does not check freshness."
    },
    "knowledge_papers_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])",
      "readOnly": true,
      "description": "Copy the generated binding unchanged; schema matching does not check freshness."
    },
    "raters": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "properties": {
          "rater_id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])"
          },
          "role": {
            "type": "string",
            "maxLength": 128
          }
        },
        "required": [
          "rater_id",
          "role"
        ],
        "additionalProperties": false
      }
    },
    "assessed_at": {
      "type": "string",
      "anyOf": [
        {
          "const": ""
        },
        {
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(?![\\s\\S])"
        }
      ],
      "description": "Empty placeholder permitted. Python checks the actual calendar date."
    },
    "method": {
      "type": "string",
      "maxLength": 2000
    },
    "scope_topics": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 2000
      },
      "uniqueItems": true
    },
    "items": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string",
            "maxLength": 128,
            "pattern": "^[^\\u0000-\\u001f\\u007f]*(?![\\s\\S])",
            "readOnly": true,
            "description": "Copy recorded rule IDs; no automatic rebinding of stale records."
          },
          "judgement": {
            "type": "string",
            "enum": [
              "AGREE",
              "PARTIAL",
              "DISAGREE",
              "NOT_ASSESSED"
            ],
            "description": "Transcribe explicit named human judgments only; no default supplied by this schema."
          },
          "rationale": {
            "type": "string",
            "maxLength": 2000
          },
          "source_locator": {
            "type": "string",
            "maxLength": 2000
          }
        },
        "required": [
          "item_id",
          "judgement",
          "rationale",
          "source_locator"
        ],
        "additionalProperties": false
      }
    },
    "limitations": {
      "type": "string",
      "maxLength": 2000
    },
    "independence_declaration": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        null,
        "RECORDED"
      ],
      "description": "Null is the generated template placeholder and is rejected as incomplete by check. RECORDED is a declaration, not approval."
    }
  },
  "required": [
    "schema_version",
    "author_id",
    "version",
    "build_id",
    "persona_payload_sha256",
    "knowledge_papers_sha256",
    "raters",
    "assessed_at",
    "method",
    "scope_topics",
    "items",
    "limitations",
    "independence_declaration",
    "status"
  ],
  "additionalProperties": false
}
